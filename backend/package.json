{
  "name": "minerecycle-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MineRecycle backend: catalog of mining asset packages",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:integration": "node scripts/run-integration-tests.js",
    "db:migrate": "sequelize-cli db:migrate --config sequelize.config.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config sequelize.config.js",
    "db:seed": "sequelize-cli db:seed:all --config sequelize.config.js",
    "import:lots": "node scripts/import-lots.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "sharp": "^0.34.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0"
  }
}
