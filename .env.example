# MineRecycle: variáveis de ambiente.
# Serve para o servidor e para o ambiente local (npm run dev e docker/compose.dev.yml leem o .env da raiz).

NODE_ENV=production
APP_PORT=3000

# PostgreSQL. No servidor: o Postgres compartilhado da VM (servidor02-infra), POSTGRES_HOST=postgres, com
# usuário e senha gerados por `scripts/criar-app.sh minerecycle` de lá. Local: o Postgres do C:\Source\infra (5432),
# senha em apps.env de lá (POSTGRES_MINERECYCLE_PASSWORD).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=minerecycle
POSTGRES_USER=minerecycle
POSTGRES_PASSWORD=minerecycle

# Segredo das sessões (vendedor e comprador). Valor aleatório forte, diferente por ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Administrador inicial (só o seeder lê; rodar uma vez). Senha com pelo menos 9 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Endereço público, usado para montar o link enviado ao comprador.
PUBLIC_BASE_URL=https://minerecycle.afbridge.com.br

# Arquivos (fotos e anexos): disco local, num volume Docker. Relativo à pasta backend/.
STORAGE_DRIVER=local
STORAGE_DIR=storage/files
# Tamanho máximo por arquivo enviado, em MB.
UPLOAD_MAX_MB=50

# Proteção do site inteiro por senha (fase de prévia). Vazio = site aberto.
SITE_USER=preview
SITE_PASSWORD=

LOG_LEVEL=info

# Produção (docker/compose.prod.yml): imagens no GHCR e porta do frontend, só em 127.0.0.1 (o NPM faz o HTTPS).
GHCR_OWNER=welersonepora
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
FRONTEND_PORT=127.0.0.1:8085
